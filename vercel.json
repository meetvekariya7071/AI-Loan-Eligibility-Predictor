{
  "version": 2,
  "functions": {
    "api/*.py": {
      "includeFiles": "api/**"
    }
  },
  "routes": [
    {
      "src": "/api/predict",
      "dest": "/api/predict.py"
    },
    {
      "src": "/api/defaults",
      "dest": "/api/defaults.py"
    },
    {
      "src": "/api/presets",
      "dest": "/api/presets.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
